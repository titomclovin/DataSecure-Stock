# Copiar como .env y completar. El archivo .env NUNCA se sube al repositorio.
PORT=3000
NODE_ENV=production

# Cadena de conexion. En produccion apunta al Replica Set de MongoDB Atlas.
MONGO_URI=mongodb+srv://<usuario>:<contrasena>@<cluster>.mongodb.net/datasecure_stock

# Firma de los JSON Web Token. Cadena aleatoria de al menos 32 caracteres.
JWT_SECRET=<cadena-aleatoria-de-al-menos-32-caracteres>
JWT_EXPIRA=2h

# Tope de peticiones por direccion IP cada 15 minutos (por defecto 300).
LIMITE_PETICIONES_15MIN=300

# Origen autorizado para CORS (dominio publico del frontend).
ORIGEN_PERMITIDO=https://datasecure-stock.onrender.com
URL_PUBLICA=https://datasecure-stock.onrender.com

# Servidor de correo para el enlace de recuperacion de credenciales.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@datasecurestock.cl
